# Copy this file to .env (repo root) and fill in real values.
# The backend reads it from ../.env relative to backend/, and refuses to start
# without JWT_SECRET.

# --- Required ---
MONGODB_URI=mongodb://localhost:27017/mallbook
JWT_SECRET=replace-with-a-long-random-string

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins.
CLIENT_URL=http://localhost:3000

# --- Optional: custom DNS resolvers for the MongoDB SRV lookup ---
# Only needed if connecting to a mongodb+srv:// cluster fails with
# "querySrv ECONNREFUSED". Leave empty to use the system resolver.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Optional: seed overrides (npm run seed) ---
SEED_ADMIN_EMAIL=admin@mall.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_MANAGER_EMAIL=manager@mall.com
SEED_MANAGER_PASSWORD=Manager@12345
SEED_CUSTOMER_PASSWORD=Customer@12345
